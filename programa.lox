fun crearPlan(aporteMensual, tasaMensual) {
    fun proyectar(capitalInicial, objetivo, maxMeses) {
        var saldo = capitalInicial;
        var mes = 0;

        print "PLAN DE AHORRO";
        print "Capital inicial";
        print capitalInicial;
        print "Meta";
        print objetivo;

        while (saldo < objetivo and mes < maxMeses) {
            mes = mes + 1;
            saldo = saldo + saldo * tasaMensual;
            saldo = saldo + aporteMensual;

            if (mes == 1 or mes % 3 == 0 or saldo >= objetivo) {
                print "Mes";
                print mes;
                print "Saldo acumulado";
                print saldo;
            }
        }

        if (saldo >= objetivo) {
            print "Meta alcanzada";
            print "Meses necesarios";
            print mes;
        } else {
            print "Meta no alcanzada dentro del plazo";
        }

        return saldo;
    }

    return proyectar;
}

var aporteMensual = 20000;
var tasaMensual = 0.01;
var calcularAhorro = crearPlan(aporteMensual, tasaMensual);
var saldoFinal = calcularAhorro(100000, 250000, 24);

print "Saldo final";
print saldoFinal;
